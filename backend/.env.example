# Backend .env.example
# Replace example values with your real credentials in deployment environments.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/anytimeyoga

# JWT
JWT_SECRET=your_jwt_secret_here

# SMTP (optional - for real emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="AnyTimeYoga <no-reply@anytimeyoga.com>"

# Admin email for notifications
ADMIN_EMAIL=admin@anytimeyoga.com

# CORS (comma-separated list of allowed origins)
# Example: CORS_ORIGIN=http://localhost:5173,https://yourdomain.com
CORS_ORIGIN=

# Rate limiter overrides (ms / count)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
